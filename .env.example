# Bat buoc: API key that, chi nam o server, khong bao gio gui xuong browser
OPENAI_API_KEY=sk-...

# Model realtime dung cho hoi thoai (WebRTC)
#
# Session chay o output_modalities:["text"] — OpenAI chi nghe va tra ve CHU.
# Tieng noi cua AI do Amazon Polly doc o phia client, nen khong con
# REALTIME_VOICE hay REALTIME_SPEED: giong nam o POLLY_VOICE, con toc do la
# playbackRate cua the <audio> va nguoi hoc tu keo.
REALTIME_MODEL=gpt-realtime

# Model text dung de cham diem grammar/vocab/objective sau buoi hoc
GRADER_TEXT_MODEL=gpt-4o

# Model audio dung de cham phat am tren cac doan wav cua user
# De trong de tat phan cham phat am bang audio
GRADER_AUDIO_MODEL=gpt-4o-audio-preview

PORT=3000

# ------------------------------------------------------------------ han muc
#
# Thoi luong goi mien phi moi thiet bi moi ngay. Mac dinh 5 phut.
# DAILY_QUOTA_MS=300000

# Moc "sang ngay moi" de reset han muc, tinh bang lech so voi UTC.
# Mac dinh 7 tieng = GMT+7.
# QUOTA_TZ_OFFSET_MS=25200000

# ------------------------------------------------------------------ audio
#
# disk (mac dinh): WAV di xuyen qua backend roi nam o data/audio/.
# s3:              client day thang len bucket bang presigned POST policy,
#                  backend chi nhan metadata. Bat len thi 4 bien duoi bat buoc.
AUDIO_STORE=disk

S3_REGION=ap-southeast-1
S3_BUCKET=ai-learn-audio
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Chi can khi chay bang credential tam (vd IAM role tren EC2/ECS). Dat vao thi
# ca S3, Polly va STS deu tu them header x-amz-security-token.
# AWS_SESSION_TOKEN=

# Chi dat khi dev voi MinIO (`docker compose --profile dev up minio`).
# Co gia tri => dung path-style URL thay vi virtual-hosted.
# S3_ENDPOINT=http://localhost:9000

# ------------------------------------------------------------------ Polly
#
# Amazon Polly tra audio KEM viseme timeline (speech marks), de avatar nhep
# dung AM VI chu khong phai doan tu pho am thanh. Dung o hai cho:
#
#   1. Man luyen khau hinh — server doc truoc tu vung/vi du cua bai, cache lai.
#   2. Hoi thoai — CLIENT tu goi Polly cho tung cau AI vua noi (can them
#      POLLY_STS_ROLE_ARN o duoi, neu khong AI se hien chu ma khong co tieng).
#
# Tat (mac dinh) thi tab luyen khau hinh tu an di.
#
# Dung chung AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY o tren.
POLLY=off

# De trong thi lay theo S3_REGION.
# POLLY_REGION=ap-southeast-1
POLLY_VOICE=Joanna

# standard | neural | long-form. KHONG dung duoc `generative`: engine do
# khong tra speech marks (ValidationException).
POLLY_ENGINE=neural

# ------------------------------- Polly tu client (STS) ---------------------
#
# De trong = AI khong noi duoc trong hoi thoai (van hien chu; man luyen khau
# hinh khong anh huong vi no goi Polly o phia server).
#
# Vi sao khong de backend goi Polly ho: khuc DAU TIEN cua moi luot la toan bo
# do tre nguoi dung cam thay, va mot vong round trip qua backend nam dung tren
# duong nong do. Client cam credential thi goi thang AWS.
#
# Role phai:
#   - cho `polly:SynthesizeSpeech` (session policy chi THU HEP them, khong
#     cong quyen vao)
#   - tin tuong AWS_ACCESS_KEY_ID o tren trong trust policy
#   - khong cho gi khac: credential nam trong browser, ban kinh thiet hai phai
#     dung o hoa don Polly
# POLLY_STS_ROLE_ARN=arn:aws:iam::123456789012:role/ai-learn-polly-client

# Han cua credential, giay. AWS chan trong 900..3600 (900 la san cua
# AssumeRole; 3600 la MaxSessionDuration mac dinh cua mot role moi tao).
# Mot buoi hoc ngan hon nhieu, nen ky mot lan la du ca buoi.
POLLY_STS_TTL_SEC=3600

# Rang credential vao IP cua chinh client (`aws:SourceIp`). Lay di cung chi
# dung duoc tu dung may do.
#
# Tat khi backend nam sau reverse proxy KHONG dat X-Forwarded-For — luc do moi
# nguoi deu chung mot IP noi bo, rang vao vua khong chan duoc ai vua lam
# credential chet oan. IP loopback/private thi code tu bo qua.
POLLY_STS_BIND_IP=on

# File .glb cua avatar. Voi Ready Player Me nho them ?morphTargets=Oculus%20Visemes
# khi tai, neu khong model se khong co morph target viseme nao.
# De trong thi man luyen tap chi ve thanh do 15 viseme (van kiem chung duoc).
# AVATAR_URL=https://models.readyplayer.me/<id>.glb?morphTargets=Oculus%20Visemes

# ------------------------------------------------------------------- CDN
#
# De trong thi van nghe lai duoc, chi la moi file mot presigned GET rieng.
# Co CDN_DOMAIN thi bat buoc co ca key pair.
#
# CDN phai cung site voi app (vd app.example.com + media.example.com), neu
# khong trinh duyet se khong dinh kem signed cookie.
# CDN_DOMAIN=media.example.com
# CF_KEY_PAIR_ID=

# Private key cua CloudFront: dat MOT trong hai. CF_PRIVATE_KEY duoc uu tien.
# CF_PRIVATE_KEY_PATH=/run/secrets/cloudfront-private-key.pem
# CF_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
