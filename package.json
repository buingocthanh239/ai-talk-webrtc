{
  "name": "ai-learn-rtc",
  "version": "1.0.0",
  "description": "Demo luyen noi tieng Anh voi AI qua OpenAI Realtime API (WebRTC)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "node build.js",
    "check": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "start": "npm run build && node --env-file-if-exists=.env server/index.ts",
    "dev": "node build.js --watch & node --watch --env-file-if-exists=.env server/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
